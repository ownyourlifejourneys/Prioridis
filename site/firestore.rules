rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Elke gebruiker mag alleen zijn eigen document lezen en schrijven.
    match /priodisUsers/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Taken staan sinds deze update in een eigen deelverzameling per
      // gebruiker, niet meer als array in het hoofddocument. Zonder deze
      // regel erven ze de rechten van het hoofddocument niet automatisch.
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Basale foutregistratie: de app mag hier een foutmelding wegschrijven,
    // ook als iemand nog niet is ingelogd (bijvoorbeeld een mislukte
    // inlogpoging). Bewust géén lezen, wijzigen of verwijderen door de app
    // zelf toegestaan: dit is alleen voor Rob, in te zien via Firebase
    // Console > Firestore Database > errorLogs.
    match /errorLogs/{logId} {
      allow create: if true;
      allow read, update, delete: if false;
    }
  }
}
